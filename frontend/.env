# Used server-side (inside the React Router/Node container) for SSR loaders/actions.
# "api" is the docker-compose service name, resolved via the internal Docker network.
API_INTERNAL_URL=http://api:8000

# Used client-side (in the browser, after hydration).
# The browser is on your host machine, not inside Docker, so it needs the
# host-mapped port, not the service name.
VITE_API_PUBLIC_URL=http://localhost:8000